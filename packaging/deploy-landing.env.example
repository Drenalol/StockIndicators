# Copy to packaging/deploy-landing.env (gitignored) and fill in the host this repository's
# own landing is published to; packaging/deploy-landing.sh reads it. Nothing here is a
# secret - the server's credentials stay in the service's own EnvironmentFile, which this
# script only reads and appends to.

# Where to deploy: ssh target and port
SI_DEPLOY_TARGET=root@your.server
SI_DEPLOY_SSH_PORT=22

# The published instance: app directory, systemd unit, and the unit's EnvironmentFile
SI_DEPLOY_DIR=/opt/stock-indicators/landing
SI_DEPLOY_SERVICE=stock-indicators-landing
SI_SERVICE_ENV_FILE=/etc/stock-indicators/landing.env

# The nginx root that serves the static site (only /api/ reaches the service); leave empty
# when the service itself serves the frontend (the wwwroot upload is then the whole story)
SI_WEB_ROOT=/srv/stock-indicators/web

# Baked into canonical/hreflang/og:url of the static shells (web/seo/copy.json's comment)
SI_SEO_BASE_URL=https://stockindicators.app
