# Optional frontend environment (copy to .env.local). Everything here has a working default,
# so an ordinary local run needs none of it.

# Where the dev server proxies /api and /hubs (default: https://localhost:5051, the URL the
# backend listens on in development).
#SI_API_URL=https://localhost:5051

# Serve the dev server over https (webauthn and service workers want a secure context).
# Give absolute paths; without both variables the dev server stays plain http.
#SI_DEV_KEY=/absolute/path/to/key.pem
#SI_DEV_CERT=/absolute/path/to/cert.pem

# Error tracking (GlitchTip speaks the Sentry protocol). Empty DSN = monitoring stays off.
#VITE_GLITCHTIP_DSN=

# The domain your instance is published under, used to recognise app links opened from the
# native shells. Comma-separated.
#VITE_APP_HOSTS=indicators.example.com

# API base for the built frontend. The default is same-origin `/api`, which is what the
# recommended single-host deployment uses; set it only when the API lives elsewhere.
#VITE_API_BASE_URL=/api
