# Copy to .env next to docker-compose.yml and edit. Only SI_PASSWORD is required:
# with nothing there the app starts but refuses every sign-in. For something stronger
# than the plain value, generate a digest with
#   dotnet run --project src/StockIndicators.API -- hash-password <your password>
# and pass it as LocalAuth__PasswordHash instead (map that variable into the api service).
SI_PASSWORD=change-me

# Host port the single origin (app + API) is published on
API_PORT=8080

# Absolute scheme+host the image is published under, baked into the SEO pages (canonical,
# og:url, sitemap). Leave empty for a LAN install; set it when a reverse proxy puts the
# instance behind a domain, and rebuild the image after changing it.
# SEO_BASE_URL=https://your.domain

# Postgres container credentials; change POSTGRES_PASSWORD before exposing anything
# beyond localhost.
POSTGRES_DB=stock_indicators
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-too
