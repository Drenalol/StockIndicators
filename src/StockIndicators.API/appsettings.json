  "TinkoffProviderOptions": {
    "IsEnabled": false,
    "Limits": [
      {
        "Value": 1,
        "Interval": "00:00:00.200"
      }
    ],
    "Token": "",
    "IsSandbox": false
  },
  "RedisConfiguration": {
    "Hosts": [
      {
        "Host": "",
        "Port": 6379
      }
    ]
  },
  "TelegramBotOptions": {
    "Token": "",
    "BotLink": "",
    "IncludeWebLinks": false,
    "InstanceUrl": "http://localhost:8080"
  },
  "YahooEnricherOptions": {
    "IsEnabled": false,
    "BaseUrl": "https://query1.finance.yahoo.com",
    "CacheTtlHours": 24,
    "NegativeCacheTtlHours": 24,
    "DeepProfile": false
  },
  "AlpacaProviderOptions": {
    "IsEnabled": false,
    "ApiKey": "",
    "ApiSecret": "",
    "Environment": "Paper",
    "CandlePollIntervalSeconds": 60,
    "Limits": [
      {
        "Value": 100,
        "Interval": "00:01:00"
      }
    ]
  },
  "BusinessQuantProviderOptions": {
    "IsEnabled": false,
    "ApiKey": "",
    "BaseUrl": "https://data.businessquant.com",
    "CandlePollIntervalSeconds": 60,
    "Limits": [
      {
        "Value": 30,
        "Interval": "00:01:00"
      },
      {
        "Value": 3000,
        "Interval": "01:00:00"
      }
    ]
  },
  "BinanceProviderOptions": {
    "IsEnabled": false,
    "BaseUrl": "https://api.binance.com",
    "MirrorBaseUrl": "https://data-api.binance.vision",
    "CandlePollIntervalSeconds": 60,
    "Limits": [
      {
        "Value": 120,
        "Interval": "00:01:00"
      },
      {
        "Value": 5000,
        "Interval": "01:00:00"
      }
    ]
  },
  // Instrument logos cascade (Tinkoff brand CDN - Logo.dev - CoinGecko): an empty Logo.dev
  // publishable key or CoinGecko demo key skips that source; Tinkoff needs no extra key
  // (its brand file names come from the already-loaded instruments catalog)
  "LogoOptions": {
    "LogoDevPublishableKey": "",
    "LogoDevBaseUrl": "https://img.logo.dev",
    "TinkoffBrandBaseUrl": "https://invest-brands.cdn-tinkoff.ru",
    "CoinGeckoBaseUrl": "https://api.coingecko.com/api/v3",
    "CoinGeckoApiKey": "",
    "RevalidateAfterDays": 30
  },
  "InstrumentsWarmupOptions": {
    "RefreshInterval": "23:50:00",
    "InitialWarmupTimeout": "00:01:00",
    "FailureRetryInterval": "00:05:00"
  },
  "WebPushOptions": {
    "VapidPublicKey": "",
    "VapidPrivateKey": "",
    "Subject": ""
  },
  "AlertOptions": {
    "PublicBaseUrl": "",
    "ImageSigningKey": "",
    "AllowPrivateWebhookTargets": false
  },
  // The alert chart image renderer: path to the frontend's dist/render/renderer.html
  // (npm run build:render); null - alerts go out without a chart image
  "ChartImage": {
    "PageHtmlPath": null
  },
  // The link-preview pictures of the public pages (og:image): the landing and the indicator
  // catalog are pictured with the example chart of this indicator (its anchored sample
  // parameters, so the trigger marker is a candle the handler really fires on)
  "ShareImage": {
    "LandingIndicator": "EMA"
  },
  "WhatsAppOptions": {
    "AccessToken": "",
    "PhoneNumberId": "",
    "TemplateName": "",
    "TemplateLanguage": "en",
    "ApiVersion": "v23.0"
  },
  // Prometheus scrape endpoint on /metrics. Off by default: nothing consumes the metrics
  // until the owner points a scraper at the instance, and until then the endpoint is a 404.
  "Metrics": {
    "Enabled": false
  },
  // How this instance faces the network. The image carries the whole product; a public
  // deployment (the project's own landing page) publishes the marketing surface only: landing,
  // indicator catalog, legal pages, link-preview pictures. With LandingOnly on, the application
  // part of the process is never wired - no session, no database, no providers, no alerts - and
  // everything outside the public surface answers 404. Leave it off on a self-hosted instance.
  "PublicSite": {
    "LandingOnly": false
  },
  // Access to this instance: one account, one password. Set LocalAuth__Password (or a
  // LocalAuth__PasswordHash from `dotnet run -- hash-password`) in the environment before
  // the app is reachable by anyone; until then every sign-in is refused.
  "LocalAuth": {
    "Password": "",
    "PasswordHash": "",
    "SessionLifetime": "14.00:00:00"
  },
  "SmtpOptions": {
    "Host": "",
    "Port": 25,
    "UseSsl": false,
    "Username": "",
    "Password": "",
    "From": ""
  },
  // Origins the frontend is served from, for CORS and the CSRF origin guard. A single-origin
  // deployment (the API serves the built frontend itself) needs nothing here; add the domain
  // you put the app behind when the frontend comes from somewhere else.
  "Frontend": {
    "Origins": []
  }
}
