{
  "Urls": "https://localhost:5051;http://localhost:5000",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        // Grpc.Net.Client's INF chatter on Tinkoff stream resets ("Error reading message" +
        // "Call failed with gRPC error status" with full stack traces): the stream is
        // re-established by the provider's own restart, so only real failures matter here.
        "Grpc": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Exchanges": {
